const mat3 AWG3_TO_XYZ_MATRIX = mat3(
	vec3(0.6377657322319539, 0.2918430909190081, 0.00279721812382431),
	vec3(0.214711897828251, 0.823871897549126, -0.06703674638076611),
	vec3(0.09767706379516013, -0.11571498846813395, 1.1524985959291891)
);

const mat3 XYZ_TO_AWG3_MATRIX = mat3(
	vec3(1.789744094473109, -0.6398246959882147, -0.04156019856368081),
	vec3(-0.48271687563225985, 1.3963476582316743, 0.08239217692138698),
	vec3(-0.20015167619709143, 0.19442500980826463, 0.8794748137211991)
);

vec3 arriwidegamut3_to_xyz(vec3 color) {
    return AWG3_TO_XYZ_MATRIX * color;
}

vec3 xyz_to_arriwidegamut3(vec3 xyz) {
    vec3 rgb = XYZ_TO_AWG3_MATRIX * xyz;
    return clamp_skip(rgb, 0.0, 1.0, u_clamped == 0);
}