	vec3(0.04942071917307374, 0.7051637617763127, -0.06199295654853109),
	vec3(0.14204055020693998, 0.0402962741217484, 1.1284450100108367)
);

const mat3 XYZ_TO_PLASA_MATRIX = mat3(
	vec3(1.3597667137470208, -0.48779625174904206, -0.05307514620276191),
	vec3(-0.10999956631599175, 1.4531330479832687, 0.08195594396550479),
	vec3(-0.16722962822473258, 0.009509546548757675, 0.8899293229852375)
);

vec3 plasaansie154_to_xyz(vec3 rgb) {
    return PLASA_TO_XYZ_MATRIX * rgb;
}

vec3 xyz_to_plasaansie154(vec3 xyz) {
    vec3 v3 = XYZ_TO_PLASA_MATRIX * xyz;
