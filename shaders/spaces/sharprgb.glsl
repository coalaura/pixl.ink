const mat3 SHARP_TO_XYZ_MATRIX = mat3(
	vec3(0.7669109242111033, 0.3586371537956673, -0.012412608810015775),
	vec3(0.02994921860950004, 0.5919920621364027, 0.016611051775784275),
	vec3(0.15329455103476153, 0.049370784067930426, 1.0840606247064792)
);

const mat3 XYZ_TO_SHARP_MATRIX = mat3(
	vec3(1.3299680978519444, -0.8080160299767709, 0.027609498173728736),
	vec3(-0.06208608670183443, 1.729093366873742, -0.027205775283153502),
	vec3(-0.18524021543994587, 0.03551255198978272, 0.9197924563490593)
);

vec3 sharprgb_to_xyz(vec3 rgb) {
    return SHARP_TO_XYZ_MATRIX * rgb;
}

vec3 xyz_to_sharprgb(vec3 xyz) {
    vec3 v3 = XYZ_TO_SHARP_MATRIX * xyz;
    return clamp_skip(v3, 0.0, 1.0, u_clamped == 0);
}
