const mat3 VGAMUT_TO_XYZ_MAT = mat3(
	vec3(0.6794173805917019, 0.26059844735024185, -0.009307087405365786),
	vec3(0.15222344372542038, 0.7749557135112309, -0.004612831628043046),
	vec3(0.11851386953824261, -0.03555416086147278, 1.1021789867056564)
);

const mat3 XYZ_TO_VGAMUT_MAT = mat3(
	vec3(1.5895428870889647, -0.5340107005045597, 0.011187577774975862),
	vec3(-0.31330917030580135, 1.3959010967821992, 0.0031964507928502477),
	vec3(-0.1810253374387855, 0.10244957306873327, 0.9061937997730443)
);

vec3 vgamut_to_xyz(vec3 rgb) {
    return VGAMUT_TO_XYZ_MAT * rgb;
}

vec3 xyz_to_vgamut(vec3 xyz) {
    vec3 rgb = XYZ_TO_VGAMUT_MAT * xyz;
    return clamp_skip(rgb, 0.0, 1.0, u_clamped == 0);
}