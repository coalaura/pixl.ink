const mat3 SGAMUT3_TO_XYZ_MATRIX = mat3(
	vec3(0.7062587471916596, 0.27089376604611604, -0.009674777358789865),
	vec3(0.12880820434594936, 0.786650105112762, 0.004600293012355338),
	vec3(0.115087742317756, -0.057543871158878, 1.093333552018682)
);

const mat3 XYZ_TO_SGAMUT3_MATRIX = mat3(
	vec3(1.5078779197971623, -0.5181229467332211, 0.015523076647866871),
	vec3(-0.24590009153615272, 1.3553159567089346, -0.00787854643936962),
	vec3(-0.1716661016384462, 0.12587167632501983, 0.9125852949919315)
);

vec3 sgamut3_to_xyz(vec3 rgb) {
    return SGAMUT3_TO_XYZ_MATRIX * rgb;
}

vec3 xyz_to_sgamut3(vec3 xyz) {
    vec3 rgb = XYZ_TO_SGAMUT3_MATRIX * xyz;
    return clamp_skip(rgb, 0.0, 1.0, u_clamped == 0);
}
