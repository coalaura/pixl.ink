const mat3 AP0_TO_XYZ_MATRIX = mat3(
	vec3(0.9379776614611017, 0.33726332127975095, 0.0011743507667093655),
	vec3(-0.004444334762508335, 0.7295716441994353, -0.003715336207029969),
	vec3(0.016621367156771566, -0.06683496547918612, 1.0908000531125681)
);

const mat3 XYZ_TO_AP0_MATRIX = mat3(
	vec3(1.063842043667357, -0.4920468927449401, -0.0028212717326414555),
	vec3(0.006400055935040349, 1.3681349753284235, 0.004653066787872316),
	vec3(-0.01581844595431223, 0.09132539517700618, 0.9170863881945762)
);

vec3 aces2065_to_xyz(vec3 rgb) {
    return AP0_TO_XYZ_MATRIX * rgb;
}

vec3 xyz_to_aces2065(vec3 xyz) {
    vec3 rgb = XYZ_TO_AP0_MATRIX * xyz;
    return clamp_skip(rgb, 0.0, 1.0, u_clamped == 0);
}
