const mat3 ADOBE_TO_XYZ_MATRIX = mat3(
	vec3(0.5764731698017479, 0.29724397817902626, 0.027022179834456903),
	vec3(0.1856062564886592, 0.6275259147949906, 0.0707071453290131),
	vec3(0.18807526756495768, 0.07523010702598307, 0.9905297425087771)
);

const mat3 XYZ_TO_ADOBE_MATRIX = mat3(
	vec3(2.0422815912010774, -0.9689928812362131, 0.01345524467801999),
	vec3(-0.5651989514221287, 1.8754821660388814, -0.11845891883197893),
	vec3(-0.34484848303143534, 0.04154430661151784, 1.0160028873540097)
);

vec3 adobergb_to_xyz(vec3 rgb) {
    vec3 rgbLin = adobeRgbToLinear(rgb);
    return ADOBE_TO_XYZ_MATRIX * rgbLin;
}

vec3 xyz_to_adobergb(vec3 xyz) {
    vec3 rgbLin = XYZ_TO_ADOBE_MATRIX * xyz;
    return clamp_skip(linearToAdobeRgb(rgbLin), 0.0, 1.0, u_clamped == 0);
}
