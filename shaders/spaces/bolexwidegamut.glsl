const mat3 BOLEX_TO_XYZ_MATRIX = mat3(
	vec3(0.600061976898984, 0.26199889132209164, -0.01690315427884459),
	vec3(0.16354010711882394, 0.6713751765930667, 0.025822122176656432),
	vec3(0.1865526098375568, 0.06662593208484172, 1.0793400997744358)
);

const mat3 XYZ_TO_BOLEX_MATRIX = mat3(
	vec3(1.8501065864318176, -0.7265899233572088, 0.04635677933811339),
	vec3(-0.4394113215751913, 1.6655942749231691, -0.04672912294725492),
	vec3(-0.29264735311320356, 0.02276898212821085, 0.9213642608205758)
);

vec3 bolexwidegamut_to_xyz(vec3 rgb) {
    return BOLEX_TO_XYZ_MATRIX * rgb;
}

vec3 xyz_to_bolexwidegamut(vec3 xyz) {
    vec3 v3 = XYZ_TO_BOLEX_MATRIX * xyz;
    return clamp_skip(v3, 0.0, 1.0, u_clamped == 0);
}
