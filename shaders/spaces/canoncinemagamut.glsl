const mat3 CANON_CG_TO_XYZ_MATRIX = mat3(
	vec3(0.715809749106725, 0.2611738273767781, -0.009673104717658455),
	vec3(0.12968484296120789, 0.8696512998575117, -0.23648412539984962),
	vec3(0.10466010178743183, -0.1308251272342898, 1.3344162977897558)
);

const mat3 XYZ_TO_CANON_CG_MATRIX = mat3(
	vec3(1.490317574638302, -0.45816175172731965, -0.07039181351609558),
	vec3(-0.26098333918829425, 1.2616145029342662, 0.22169040024363712),
	vec3(-0.14247425479401332, 0.15962195140354138, 0.7766466063871295)
);

vec3 canoncinemagamut_to_xyz(vec3 rgb) {
    return CANON_CG_TO_XYZ_MATRIX * rgb;
}

vec3 xyz_to_canoncinemagamut(vec3 xyz) {
    vec3 v3 = XYZ_TO_CANON_CG_MATRIX * xyz;
    return clamp_skip(v3, 0.0, 1.0, u_clamped == 0);
}
