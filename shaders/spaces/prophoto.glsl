const mat3 PROPHOTO_TO_XYZ_MATRIX = mat3(
	vec3(0.7553114288386402, 0.26823653762044747, 0.003909134745003229),
	vec3(0.11280108928869649, 0.7152306981579717, -0.012923694609705362),
	vec3(0.08204217572802816, 0.016532764221580794, 1.09727362753695)
);

const mat3 XYZ_TO_PROPHOTO_MATRIX = mat3(
	vec3(1.4037582442141647, -0.5261996001026628, -0.011198595093459888),
	vec3(-0.22322648363504793, 1.4814463112975502, 0.01824374669060621),
	vec3(-0.10159437621750556, 0.017022333371808702, 0.9119121360732018)
);

vec3 prophoto_to_xyz(vec3 rgb) {
    vec3 rgbLin = prophotoToLinear(rgb);
    return PROPHOTO_TO_XYZ_MATRIX * rgbLin;
}

vec3 xyz_to_prophoto(vec3 xyz) {
    vec3 rgbLin = XYZ_TO_PROPHOTO_MATRIX * xyz;
    return linearToProphoto(rgbLin);
}